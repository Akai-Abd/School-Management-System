generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolStatus {
  active
  inactive
  suspended
}

enum MembershipStatus {
  active
  suspended
}

enum StorageProvider {
  local
  s3
}

enum FileVisibility {
  private
  public
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  isActive        Boolean   @default(true) @map("is_active")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships          SchoolMembership[]
  sessions             Session[]             @relation("SessionUser")
  impersonatedSessions Session[]             @relation("SessionImpersonator")
  passwordResetTokens  PasswordResetToken[]
  mfaMethods           UserMfaMethod[]
  mfaRecoveryCodes     MfaRecoveryCode[]
  sentInvitations      UserInvitation[]      @relation("InvitationSender")
  staffProfiles        Staff[]
  studentProfiles      Student[]
  guardianProfiles     Guardian[]
  importBatches        ImportBatch[]
  uploadedAttachments  Attachment[]
  auditLogs            AuditLog[]

  @@map("users")
}

model School {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String
  status    SchoolStatus @default(active)
  timezone  String       @default("Asia/Kolkata")
  currency  String       @default("INR")
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  settings                 SchoolSetting?
  modules                  SchoolModule[]
  memberships              SchoolMembership[]
  roles                    Role[]
  sessions                 Session[]
  invitations              UserInvitation[]
  documentSequences        DocumentSequence[]
  idempotencyKeys          IdempotencyKey[]
  attachments              Attachment[]
  auditLogs                AuditLog[]
  academicYears            AcademicYear[]
  academicTerms            AcademicTerm[]
  calendarEvents           CalendarEvent[]
  classes                  SchoolClass[]
  sections                 Section[]
  subjects                 Subject[]
  subjectGroups            SubjectGroup[]
  classSubjects            ClassSubject[]
  departments              Department[]
  designations             Designation[]
  staff                    Staff[]
  staffHistory             StaffEmploymentHistory[]
  teacherProfiles          TeacherProfile[]
  classTeachers            ClassTeacher[]
  teacherAssignments       TeacherAssignment[]
  students                 Student[]
  guardians                Guardian[]
  studentGuardians         StudentGuardian[]
  studentEnrollments       StudentEnrollment[]
  studentSubjects          StudentSubject[]
  studentMedicalRecords    StudentMedicalRecord[]
  studentEmergencyContacts StudentEmergencyContact[]
  importBatches            ImportBatch[]
  attendanceSessions       AttendanceSession[]
  studentAttendances       StudentAttendance[]
  staffAttendances         StaffAttendance[]
  leaveRequests            LeaveRequest[]
  timetablePeriods         TimetablePeriod[]
  classrooms               Classroom[]
  timetableEntries         TimetableEntry[]
  exams                    Exam[]
  examSubjects             ExamSubject[]
  marks                    Mark[]
  markRevisions            MarkRevision[]
  homeworks                Homework[]
  homeworkSubmissions      HomeworkSubmission[]
  studentPromotions        StudentPromotion[]
  notifications            Notification[]
  feeTypes                 FeeType[]
  feeStructures            FeeStructure[]
  feeStructureItems        FeeStructureItem[]
  invoices                 Invoice[]
  invoiceItems             InvoiceItem[]
  payments                 Payment[]
  paymentAllocations       PaymentAllocation[]
  studentCredits           StudentCredit[]
  paymentRefunds           PaymentRefund[]
  financialEvents          FinancialEvent[]
  accounts                 Account[]
  fiscalYears              FiscalYear[]
  accountingPeriods        AccountingPeriod[]
  postingRules             PostingRule[]
  journalEntries           JournalEntry[]
  journalEntryLines        JournalEntryLine[]
  bookCategories           BookCategory[]
  books                    Book[]
  bookCopies               BookCopy[]
  bookIssues               BookIssue[]
  vehicles                 Vehicle[]
  transportRoutes          TransportRoute[]
  routeStops               RouteStop[]
  transportAssignments     TransportAssignment[]
  transportAttendances     TransportAttendance[]
  hostels                  Hostel[]
  hostelRooms              HostelRoom[]
  hostelBeds               HostelBed[]
  hostelAllocations        HostelAllocation[]
  notificationDeliveries   NotificationDelivery[]
  messages                 Message[]
  questionBanks            QuestionBank[]
  questions                Question[]
  questionOptions          QuestionOption[]
  onlineExams              OnlineExam[]
  onlineExamQuestions      OnlineExamQuestion[]
  examAttempts             ExamAttempt[]
  examAnswers              ExamAnswer[]
  websiteSetting           WebsiteSetting?
  websitePages             WebsitePage[]
  websiteAnnouncements     WebsiteAnnouncement[]
  websiteEvents            WebsiteEvent[]
  admissionApplications    AdmissionApplication[]
  contactInquiries         ContactInquiry[]
  subscription             SchoolSubscription?
  supportAccessGrants      SupportAccessGrant[]

  @@map("schools")
}

model SchoolMembership {
  id        String           @id @default(uuid()) @db.Uuid
  schoolId  String           @map("school_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  userRoles UserRole[]

  @@unique([schoolId, userId])
  @@unique([id, schoolId])
  @@index([userId])
  @@map("school_memberships")
}

model Role {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  key       String
  name      String
  isSystem  Boolean   @default(false) @map("is_system")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  module      String
  action      String
  code        String @unique
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  schoolId     String @map("school_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId, schoolId], references: [id, schoolId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([schoolId])
  @@map("role_permissions")
}

model UserRole {
  schoolMembershipId String @map("school_membership_id") @db.Uuid
  schoolId           String @map("school_id") @db.Uuid
  roleId             String @map("role_id") @db.Uuid

  membership SchoolMembership @relation(fields: [schoolMembershipId, schoolId], references: [id, schoolId], onDelete: Cascade)
  role       Role             @relation(fields: [roleId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@id([schoolMembershipId, roleId])
  @@index([schoolId])
  @@map("user_roles")
}

model Session {
  id                   String    @id @default(uuid()) @db.Uuid
  tokenHash            String    @unique @map("token_hash")
  csrfToken            String    @map("csrf_token")
  userId               String    @map("user_id") @db.Uuid
  activeSchoolId       String?   @map("active_school_id") @db.Uuid
  impersonatedByUserId String?   @map("impersonated_by_user_id") @db.Uuid
  ipAddress            String?   @map("ip_address")
  userAgent            String?   @map("user_agent")
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz

  user           User    @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy User?   @relation("SessionImpersonator", fields: [impersonatedByUserId], references: [id], onDelete: SetNull)
  activeSchool   School? @relation(fields: [activeSchoolId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model UserMfaMethod {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  methodType String    @default("totp") @map("method_type")
  secret     String
  isActive   Boolean   @default(false) @map("is_active")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_mfa_methods")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model DocumentSequence {
  id         String @id @default(uuid()) @db.Uuid
  schoolId   String @map("school_id") @db.Uuid
  docType    String @map("doc_type")
  scopeKey   String @default("default") @map("scope_key")
  prefix     String @default("")
  nextNumber Int    @default(1) @map("next_number")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, docType, scopeKey])
  @@map("document_sequences")
}

model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  key          String
  route        String
  requestHash  String   @map("request_hash")
  statusCode   Int      @map("status_code")
  responseJson Json     @map("response_json")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key, route])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model Attachment {
  id               String          @id @default(uuid()) @db.Uuid
  schoolId         String          @map("school_id") @db.Uuid
  uploadedByUserId String          @map("uploaded_by_user_id") @db.Uuid
  originalName     String          @map("original_name")
  storageKey       String          @unique @map("storage_key")
  storageProvider  StorageProvider @map("storage_provider")
  visibility       FileVisibility  @default(private)
  mimeType         String          @map("mime_type")
  sizeBytes        Int             @map("size_bytes")
  entityType       String?         @map("entity_type")
  entityId         String?         @map("entity_id") @db.Uuid
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz

  school     School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  uploadedBy User   @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, schoolId])
  @@index([schoolId, entityType, entityId])
  @@map("attachments")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}

model SchoolSetting {
  id                     String   @id @default(uuid()) @db.Uuid
  schoolId               String   @unique @map("school_id") @db.Uuid
  locale                 String   @default("en-IN")
  dateFormat             String   @default("DD/MM/YYYY") @map("date_format")
  workingDays            Json     @default("[\"mon\",\"tue\",\"wed\",\"thu\",\"fri\",\"sat\"]") @map("working_days")
  roundingPolicy         String   @default("per_line_half_up") @map("rounding_policy")
  studentFeeViewEnabled  Boolean  @default(false) @map("student_fee_view_enabled")
  discountApprovalAmount Decimal? @map("discount_approval_amount") @db.Decimal(12, 2)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}

model SchoolModule {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  moduleKey String   @map("module_key")
  isEnabled Boolean  @default(true) @map("is_enabled")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, moduleKey])
  @@index([schoolId])
  @@map("school_modules")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  email      String
  ipAddress  String?  @map("ip_address")
  succeeded  Boolean
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, createdAt])
  @@map("login_attempts")
}

model UserInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  email           String
  roleId          String    @map("role_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  invitedByUserId String    @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([schoolId, email])
  @@map("user_invitations")
}

// ============================================================================
// Phase 1 — M04 Academic Structure
// ============================================================================

enum CalendarEventType {
  holiday
  event
  exam_period
  working_day
}

model AcademicYear {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  name      String
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  isCurrent Boolean   @default(false) @map("is_current")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  terms              AcademicTerm[]
  calendarEvents     CalendarEvent[]
  subjectGroups      SubjectGroup[]
  classSubjects      ClassSubject[]
  classTeachers      ClassTeacher[]
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentEnrollment[]

  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("academic_years")
}

model AcademicTerm {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId])
  @@map("academic_terms")
}

model CalendarEvent {
  id             String            @id @default(uuid()) @db.Uuid
  schoolId       String            @map("school_id") @db.Uuid
  academicYearId String            @map("academic_year_id") @db.Uuid
  title          String
  eventType      CalendarEventType @map("event_type")
  startDate      DateTime          @map("start_date") @db.Date
  endDate        DateTime          @map("end_date") @db.Date
  description    String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([schoolId, startDate])
  @@map("calendar_events")
}

model SchoolClass {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  name         String
  code         String?
  displayOrder Int       @default(0) @map("display_order")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  school        School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  sections      Section[]
  subjectGroups SubjectGroup[]
  classSubjects ClassSubject[]
  enrollments           StudentEnrollment[]
  admissionApplications AdmissionApplication[]

  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("classes")
}

model Section {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  name      String
  capacity  Int?
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  schoolClass        SchoolClass         @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: Cascade)
  classTeachers      ClassTeacher[]
  teacherAssignments TeacherAssignment[]
  enrollments        StudentEnrollment[]

  @@unique([id, schoolId])
  @@index([schoolId, classId])
  @@map("sections")
}

model Subject {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  name       String
  code       String
  isElective Boolean   @default(false) @map("is_elective")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  studentSubjects    StudentSubject[]

  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("subjects")
}

model SubjectGroup {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  name           String
  minSelect      Int      @default(1) @map("min_select")
  maxSelect      Int      @default(1) @map("max_select")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear  AcademicYear   @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  schoolClass   SchoolClass    @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: Cascade)
  classSubjects ClassSubject[]

  @@unique([schoolId, academicYearId, classId, name])
  @@map("subject_groups")
}

model ClassSubject {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  subjectGroupId String?  @map("subject_group_id") @db.Uuid
  isMandatory    Boolean  @default(true) @map("is_mandatory")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear AcademicYear  @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  schoolClass  SchoolClass   @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject      Subject       @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subjectGroup SubjectGroup? @relation(fields: [subjectGroupId], references: [id], onDelete: SetNull)

  @@unique([schoolId, academicYearId, classId, subjectId])
  @@index([schoolId])
  @@map("class_subjects")
}

// ============================================================================
// Phase 1 — M03 Staff & Teachers
// ============================================================================

enum StaffStatus {
  active
  on_leave
  suspended
  resigned
}

model Department {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  name      String
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  school School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  staff  Staff[]

  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("departments")
}

model Designation {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  name      String
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  school School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  staff  Staff[]

  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("designations")
}

model Staff {
  id            String      @id @default(uuid()) @db.Uuid
  schoolId      String      @map("school_id") @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  employeeCode  String      @map("employee_code")
