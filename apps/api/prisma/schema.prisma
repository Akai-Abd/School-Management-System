  question   Question   @relation(fields: [questionId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([schoolId, onlineExamId, questionId])
  @@map("online_exam_questions")
}

model ExamAttempt {
  id           String        @id @default(uuid()) @db.Uuid
  schoolId     String        @map("school_id") @db.Uuid
  onlineExamId String        @map("online_exam_id") @db.Uuid
  studentId    String        @map("student_id") @db.Uuid
  startedAt    DateTime      @default(now()) @map("started_at") @db.Timestamptz
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz
  submittedAt  DateTime?     @map("submitted_at") @db.Timestamptz
  totalScore   Decimal       @default(0) @map("total_score") @db.Decimal(8, 2)
  status       AttemptStatus @default(in_progress)

  school     School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  onlineExam OnlineExam   @relation(fields: [onlineExamId, schoolId], references: [id, schoolId], onDelete: Cascade)
  answers    ExamAnswer[]

  @@unique([id, schoolId])
  @@unique([schoolId, onlineExamId, studentId])
  @@map("exam_attempts")
}

model ExamAnswer {
  id                String   @id @default(uuid()) @db.Uuid
  schoolId          String   @map("school_id") @db.Uuid
  attemptId         String   @map("attempt_id") @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  answerText        String?  @map("answer_text")
  selectedOptionIds Json?    @map("selected_option_ids")
  marksAwarded      Decimal? @map("marks_awarded") @db.Decimal(8, 2)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  school  School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  attempt ExamAttempt @relation(fields: [attemptId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([schoolId, attemptId, questionId])
  @@map("exam_answers")
}

model WebsiteSetting {
  id               String  @id @default(uuid()) @db.Uuid
  schoolId         String  @unique @map("school_id") @db.Uuid
  tagline          String?
  principalMessage String? @map("principal_message")
  contactEmail     String? @map("contact_email")
  contactPhone     String? @map("contact_phone")
  address          String?
  seoDescription   String? @map("seo_description")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("website_settings")
}

model WebsitePage {
  id             String            @id @default(uuid()) @db.Uuid
  schoolId       String            @map("school_id") @db.Uuid
  slug           String
  title          String
  contentHtml    String            @map("content_html")
  seoTitle       String?           @map("seo_title")
  seoDescription String?           @map("seo_description")
  status         WebsitePageStatus @default(draft)
  publishedAt    DateTime?         @map("published_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, slug])
  @@map("website_pages")
}

model WebsiteAnnouncement {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  title       String
  body        String
  isPublished Boolean   @default(true) @map("is_published")
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, isPublished])
  @@map("website_announcements")
}

model WebsiteEvent {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  title       String
  eventDate   DateTime @map("event_date") @db.Date
  description String?
  isPublished Boolean  @default(true) @map("is_published")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, isPublished])
  @@map("website_events")
}

model AdmissionApplication {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  classId        String?      @map("class_id") @db.Uuid
  studentName    String       @map("student_name")
  dateOfBirth    DateTime     @map("date_of_birth") @db.Date
  gender         String?
  guardianName   String       @map("guardian_name")
  phone          String
  email          String
  previousSchool String?      @map("previous_school")
  address        String?
  message        String?
  status         String       @default("pending")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass? @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@map("admission_applications")
}

model ContactInquiry {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@map("contact_inquiries")
}

// ============================================================================
// Phase 6 — SaaS Plans, Support Access Grants & Platform Audit
// ============================================================================

enum SubscriptionStatus {
  trial
  active
  past_due
  cancelled
}

model SubscriptionPlan {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique
  name               String
  maxStudents        Int      @default(1000) @map("max_students")
  maxStaff           Int      @default(200) @map("max_staff")
  enabledModulesJson Json     @map("enabled_modules_json")
  priceMonthlyInr    Decimal  @default(0) @map("price_monthly_inr") @db.Decimal(10, 2)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  subscriptions SchoolSubscription[]

  @@map("subscription_plans")
}

model SchoolSubscription {
  id        String             @id @default(uuid()) @db.Uuid
  schoolId  String             @unique @map("school_id") @db.Uuid
  planId    String             @map("plan_id") @db.Uuid
  status    SubscriptionStatus @default(trial)
  startsAt  DateTime           @default(now()) @map("starts_at") @db.Timestamptz
  endsAt    DateTime?          @map("ends_at") @db.Timestamptz
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  school School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("school_subscriptions")
}

model SupportAccessGrant {
  id             String    @id @default(uuid()) @db.Uuid
  schoolId       String    @map("school_id") @db.Uuid
  platformUserId String    @map("platform_user_id") @db.Uuid
  reason         String
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, platformUserId])
  @@map("support_access_grants")
}

model PlatformAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  action      String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@map("platform_audit_logs")
}
