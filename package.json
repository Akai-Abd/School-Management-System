{
  "name": "school-erp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @school-erp/api --filter @school-erp/web dev",
    "build": "pnpm --filter @school-erp/contracts build && pnpm --filter @school-erp/api build && pnpm --filter @school-erp/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @school-erp/api db:generate",
    "db:push": "pnpm --filter @school-erp/api db:push",
    "db:migrate": "pnpm --filter @school-erp/api db:migrate",
    "db:bootstrap": "pnpm --filter @school-erp/api db:bootstrap"
  }
}
