# Application mode: saas | standalone
APP_MODE=standalone
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Database & Queue
DATABASE_URL=postgresql://school_erp:school_erp_dev@localhost:5432/school_erp?schema=public
REDIS_URL=redis://localhost:6379

# Security (minimum 32 characters in production)
SESSION_SECRET=change-me-to-a-long-random-secret-32chars
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
ENABLE_DEMO_QUICK_SIGNIN=false
INSTALL_BOOTSTRAP_TOKEN=change-me-bootstrap-token

# Storage: local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# S3 (required only when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
